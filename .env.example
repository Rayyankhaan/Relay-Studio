# ==============================================================================
# ShortsPilot - Xavier Memes Configuration
# Copy this file to .env and fill in your credentials. Never commit .env.
# ==============================================================================

# Gemini AI Key (used server-side only for optional AI Meme Analysis & Audio Research)
# Obtain from Google AI Studio -> Get API Key
GEMINI_API_KEY=
AI_API_KEY=

# Google Cloud OAuth 2.0 & YouTube Data API v3 / Analytics API
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Application URL (used for OAuth callbacks & self-referential links)
APP_URL=http://localhost:3000

# Local SQLite database path
DATABASE_URL=file:./database/shortspilot.db

# Encryption secret for stored OAuth refresh tokens (32+ random characters)
TOKEN_ENCRYPTION_SECRET=

# Optional Dashboard Access Passphrase (leave empty for local dev access)
DASHBOARD_PASSWORD=
